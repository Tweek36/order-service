# Application Settings
APP_NAME=Order Service
APP_VERSION=1.0.0
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Settings
POSTGRES_HOST=postgres-postgresql.postgres.svc
POSTGRES_PORT=5432
POSTGRES_USERNAME=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE_NAME=student_Tweek36-order-service-postgres
# Optional: полная строка подключения (если указана, используется вместо отдельных параметров)
# POSTGRES_CONNECTION_STRING=postgresql://user:password@host:port/dbname

# Capashino Settings
CAPASHINO_BASE_URL=https://capashino.dev-2.python-labs.ru
X_API_KEY=your_api_key_here

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=kafka.kafka.svc.cluster.local:9092
KAFKA_ORDER_EVENTS_TOPIC=student_system-order.events
KAFKA_SHIPMENT_EVENTS_TOPIC=student_system-shipment.events
KAFKA_CONSUMER_GROUP=order-service-group

# Service Settings
SERVICE_NAME=order-service
SERVICE_NAMESPACE=student-tweek36-order-service
SERVICE_PORT=8000

# Logging
LOG_LEVEL=INFO
